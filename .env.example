# Example environment variables
# Copy this file to .env.local and update values as needed

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# CDN Configuration (if using remote image hosting)
NEXT_PUBLIC_CDN_URL=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_COMMENTS=false
